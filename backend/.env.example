# ── ATS Parser — FastAPI / Python backend env variables ─────────────────────
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env to git.

ENVIRONMENT=development

# PostgreSQL (Neon in production, local Docker in dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atsparser

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 file storage
R2_BUCKET=atsparser-resumes
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=REPLACE_ME
R2_SECRET_KEY=REPLACE_ME

# Clerk — server-side secret key for JWT verification
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Sentry — error tracking DSN (leave blank to disable in dev)
SENTRY_DSN=
