# ── ATS Parser — Next.js environment variables ──────────────────────────────
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.

# Backend API base URL (proxied in production via Cloudflare)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk — frontend public key (safe to expose)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Clerk — server-side secret (used in middleware only, never sent to browser)
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Clerk redirect paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard/upload
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard/upload

# PostHog — product analytics (safe to expose)
NEXT_PUBLIC_POSTHOG_KEY=phc_REPLACE_ME
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
